CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Sign-up route redirects to sign-in; keep this aligned with src/app/sign-up/page.tsx.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Reasoning effort for chat answers (reasoning models only): none|minimal|low|medium|high|xhigh|max.
# Lower = tokens start streaming sooner. Defaults to "low".
OPENAI_CHAT_REASONING_EFFORT=low

# Local evaluation harness. Use a judge stronger than OPENAI_CHAT_MODEL.
EVAL_AUTHOR_MODEL=gpt-5.6-luna
EVAL_JUDGE_MODEL=gpt-5.6-luna
EVAL_JUDGE_PASSES=2

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-0

